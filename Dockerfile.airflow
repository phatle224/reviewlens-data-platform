# syntax=docker/dockerfile:1.18
FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS uv
FROM apache/airflow:3.3.0-python3.13@sha256:fb2c895e33395e4224c3de041e1751b095ee2c214cdf2d330bbaf62fcce0f54b AS runtime

ENV PYTHONPATH="/opt/reviewlens/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /opt/reviewlens

USER root
COPY --from=uv /uv /uvx /bin/
COPY --chown=airflow:root pyproject.toml uv.lock README.md /opt/reviewlens/
COPY --chown=airflow:root src /opt/reviewlens/src
COPY --chown=airflow:root config /opt/reviewlens/config
COPY --chown=airflow:root docs/DATA_ATTRIBUTION.md /opt/reviewlens/docs/DATA_ATTRIBUTION.md
COPY --chown=airflow:root airflow/dags /opt/reviewlens/airflow/dags
COPY --chown=airflow:root airflow/pools.json /opt/reviewlens/airflow/pools.json
COPY --chown=airflow:root deploy/airflow-entrypoint.sh /opt/reviewlens/deploy/airflow-entrypoint.sh
RUN uv export --locked --no-dev --group airflow --no-emit-project --no-annotate \
      --output-file /tmp/reviewlens-requirements.txt \
    && uv pip install --system --requirement /tmp/reviewlens-requirements.txt --no-cache \
    && rm -f /tmp/reviewlens-requirements.txt \
    && mkdir -p /opt/airflow/runtime \
    && chown airflow:root /opt/airflow/runtime \
    && chmod 0755 /opt/reviewlens/deploy/airflow-entrypoint.sh

USER airflow
RUN /home/airflow/.local/bin/python -m pip uninstall --yes chardet
WORKDIR /opt/reviewlens
USER 50000:0
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/v2/monitor/health', timeout=3)" || exit 1

ENTRYPOINT ["/opt/reviewlens/deploy/airflow-entrypoint.sh"]

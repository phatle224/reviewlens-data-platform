# Copy this file to .env locally, then fill in your own credentials.
# Never commit .env or paste its values into issues, logs, screenshots, or docs.

# Owner/bootstrap credentials used only by opt-in synthetic M1 live tests.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Snowflake service connection (prefer key-pair authentication).
# Keep the private key outside this repository and reference it by local path.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PASSWORD=

# Dedicated runtime R2 identities. Ingest uses bucket-scoped Object Read & Write;
# the Snowflake stage uses a separate bucket-scoped Object Read Only credential.
R2_INGEST_ACCESS_KEY_ID=
R2_INGEST_SECRET_ACCESS_KEY=
R2_STAGE_ACCESS_KEY_ID=
R2_STAGE_SECRET_ACCESS_KEY=

# Dedicated Snowflake TYPE=SERVICE key-pair paths. Keep keys outside the repo.
# Passphrases are optional for unencrypted PKCS#8 keys but recommended locally.
# Set REVIEWLENS_ENABLE_OLIST_PIPELINE=1 only for an intentional private DAG run.
REVIEWLENS_ENABLE_OLIST_PIPELINE=0
# Keep 1 for normal run/retry. Increment only for an explicit same-release backfill.
REVIEWLENS_BACKFILL_ATTEMPT_NUMBER=1
SNOWFLAKE_INGEST_PRIVATE_KEY_PATH=
SNOWFLAKE_INGEST_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_TRANSFORM_PRIVATE_KEY_PATH=
SNOWFLAKE_TRANSFORM_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_AI_ENRICH_PRIVATE_KEY_PATH=
SNOWFLAKE_AI_ENRICH_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_VECTOR_INDEXER_PRIVATE_KEY_PATH=
SNOWFLAKE_VECTOR_INDEXER_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_GOLD_BUILDER_PRIVATE_KEY_PATH=
SNOWFLAKE_GOLD_BUILDER_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ANALYTICS_PRIVATE_KEY_PATH=
SNOWFLAKE_ANALYTICS_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_TEXT_TO_SQL_PRIVATE_KEY_PATH=
SNOWFLAKE_TEXT_TO_SQL_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_RAG_PRIVATE_KEY_PATH=
SNOWFLAKE_RAG_PRIVATE_KEY_PASSPHRASE=

# OpenRouter, Chroma adapter boundary and local app authentication.
OPENROUTER_API_KEY=
CHROMA_AUTH_TOKEN=
# Use a unique random local token; do not reuse a provider credential.
APP_AUTH_TOKEN=

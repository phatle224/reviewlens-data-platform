# Copy this file to .env locally, then fill in your own credentials.
# Never commit .env or paste its values into issues, logs, screenshots, or docs.

# Cloudflare R2 S3-compatible access (synthetic data only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Snowflake service connection (prefer key-pair authentication).
# Keep the private key outside this repository and reference it by local path.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PASSWORD=

# OpenRouter and local app authentication
OPENROUTER_API_KEY=
APP_AUTH_TOKEN=
